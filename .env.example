# Ollama Configuration
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# Output Configuration
OUTPUT_DIR=./output

# Email Credentials for Login Flows
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-email-password

# ──────────────────────────────────────────────
# Git Hook Settings
# ──────────────────────────────────────────────

# HOOK_BLOCKING controls whether a failed test-case generation blocks the push.
#   true  → push is BLOCKED if Ollama fails or generation errors out (recommended)
#   false → push goes through regardless; a warning is shown instead
HOOK_BLOCKING=true
